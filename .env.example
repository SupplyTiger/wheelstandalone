# Plain Postgres connection string.
# Local example: postgresql://wheel:wheel@localhost:5432/the_wheel
DATABASE_URL=

# Set true for hosted Postgres providers that require SSL.
DATABASE_SSL=false

SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
SNAPTRADE_PRIMARY_ACCOUNT_NUMBER=
SNAPTRADE_SECONDARY_ACCOUNT_NUMBER=

# Local-only auth bypass. Only works on localhost while NODE_ENV is not production.
# Leave LOCAL_DEV_AUTH_AUTO_LOGIN=false when you want to test the real login screen.
LOCAL_DEV_AUTH_AUTO_LOGIN=false
LOCAL_DEV_AUTH_EMAIL=
